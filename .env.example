HOST=127.0.0.1
PORT=4173
DATABASE_PATH=.local/amyrtle.sqlite
# Defaults to demo mode; seeded demo accounts are only supported on loopback.
DEMO_MODE=true
# 32-byte hex secret. Local mode automatically creates .local/key (ignored).
DATA_KEY=
PUBLIC_ORIGIN=http://127.0.0.1:4173
AI_PROVIDER=mock
AI_DAILY_LIMIT=10
AI_MONTHLY_LIMIT=30
# External calls are off by default. Configure only after provider/cost approval.
ALLOW_EXTERNAL_AI=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
